# Supabase > Connect > Transaction pooler (Vercel runtime, port 6543).
# URL-encode special characters in the database password.
DATABASE_URL="postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require"

# Supabase > Connect > Direct connection, or Session pooler for IPv4 (port 5432).
# Used by Prisma migrations only; do not expose either URL through NEXT_PUBLIC_*.
DIRECT_URL="postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"
